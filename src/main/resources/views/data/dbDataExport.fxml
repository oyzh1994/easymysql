<?xml version="1.0" encoding="UTF-8"?>
<?import cn.oyzh.easydb.fx.data.DataDateTextFiled?>
<?import cn.oyzh.easydb.fx.data.DataExportColumnListView?>
<?import cn.oyzh.easydb.fx.data.DataExportTableComboBox?>
<?import cn.oyzh.easydb.fx.data.DataExportTableTableView?>
<?import cn.oyzh.easydb.fx.data.DataFieldSeparatorComboBox?>
<?import cn.oyzh.easydb.fx.data.DataRecordSeparatorComboBox?>
<?import cn.oyzh.easydb.fx.data.DataTxtIdentifierComboBox?>
<?import cn.oyzh.fx.plus.controls.area.MsgTextArea?>
<?import cn.oyzh.fx.plus.controls.box.FlexHBox?>
<?import cn.oyzh.fx.plus.controls.box.FlexVBox?>
<?import cn.oyzh.fx.plus.controls.button.CancelButton?>
<?import cn.oyzh.fx.plus.controls.button.ExportButton?>
<?import cn.oyzh.fx.plus.controls.button.FlexButton?>
<?import cn.oyzh.fx.plus.controls.button.FlexCheckBox?>
<?import cn.oyzh.fx.plus.controls.button.FXCheckBox?>
<?import cn.oyzh.fx.plus.controls.button.FXRadioButton?>
<?import cn.oyzh.fx.plus.controls.button.NextStepButton?>
<?import cn.oyzh.fx.plus.controls.button.PrevStepButton?>
<?import cn.oyzh.fx.plus.controls.button.StopButton?>
<?import cn.oyzh.fx.plus.controls.table.FlexTableColumn?>
<?import cn.oyzh.fx.plus.controls.text.FlexLabel?>
<?import cn.oyzh.fx.plus.controls.text.FXLabel?>
<?import cn.oyzh.fx.plus.controls.toggle.FXToggleGroup?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<FlexVBox styleClass="root" xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="cn.oyzh.easydb.controller.data.DBDataExportController" realWidth="700" realHeight="650">
    <FlexVBox fx:id="step1" flexHeight="100%" flexWidth="100%">
        <FlexLabel text="%db.export.tip4" realHeight="30" fontSize="16">
            <VBox.margin>
                <Insets left="30" top="10"/>
            </VBox.margin>
        </FlexLabel>
        <FlexVBox flexHeight="100% - 100" flexWidth="100%">
            <fx:define>
                <FXToggleGroup fx:id="fileType"/>
            </fx:define>
            <FXRadioButton toggleGroup="$fileType" text="%base.sqlType" selected="true" userData="sql">
                <VBox.margin>
                    <Insets left="30" top="15"/>
                </VBox.margin>
            </FXRadioButton>
            <FXRadioButton toggleGroup="$fileType" text="%base.jsonType" userData="json">
                <VBox.margin>
                    <Insets left="30" top="15"/>
                </VBox.margin>
            </FXRadioButton>
            <FXRadioButton toggleGroup="$fileType" text="%base.xmlType" userData="xml">
                <VBox.margin>
                    <Insets left="30" top="15"/>
                </VBox.margin>
            </FXRadioButton>
            <FXRadioButton toggleGroup="$fileType" text="%base.csvType" userData="csv">
                <VBox.margin>
                    <Insets left="30" top="15"/>
                </VBox.margin>
            </FXRadioButton>
            <FXRadioButton toggleGroup="$fileType" text="%base.htmlType" userData="html">
                <VBox.margin>
                    <Insets left="30" top="15"/>
                </VBox.margin>
            </FXRadioButton>
            <FXRadioButton toggleGroup="$fileType" text="%base.xlsType" userData="xls">
                <VBox.margin>
                    <Insets left="30" top="15"/>
                </VBox.margin>
            </FXRadioButton>
            <FXRadioButton toggleGroup="$fileType" text="%base.xlsxType" userData="xlsx">
                <VBox.margin>
                    <Insets left="30" top="15"/>
                </VBox.margin>
            </FXRadioButton>
            <FXRadioButton toggleGroup="$fileType" text="%base.txtType" userData="txt">
                <VBox.margin>
                    <Insets left="30" top="15"/>
                </VBox.margin>
            </FXRadioButton>
        </FlexVBox>
        <FlexHBox flexWidth="100%" realHeight="50">
            <NextStepButton onAction="#showStep2" realHeight="30" iconSizePercent="0.75">
                <HBox.margin>
                    <Insets left="30" top="10"/>
                </HBox.margin>
            </NextStepButton>
            <CancelButton iconSizePercent="0.6" realHeight="30">
                <HBox.margin>
                    <Insets left="15" top="10"/>
                </HBox.margin>
            </CancelButton>
        </FlexHBox>
    </FlexVBox>
    <FlexVBox fx:id="step2" flexHeight="100%" flexWidth="100%" managed="false" visible="false">
        <FlexLabel text="%db.export.tip5" realHeight="30" fontSize="16">
            <VBox.margin>
                <Insets left="30" top="10"/>
            </VBox.margin>
        </FlexLabel>
        <FlexVBox flexHeight="100% - 100" flexWidth="100%">
            <DataExportTableTableView fx:id="exportTableView" flexHeight="100% - 60" flexWidth="100% - 40">
                <columns>
                    <FlexTableColumn realWidth="50" fx:id="exportTableSelected"/>
                    <FlexTableColumn flexWidth="35%" fx:id="exportTableName" text="%base.source" resizable="true"/>
                    <FlexTableColumn flexWidth="65% - 65" fx:id="exportTableFilePath" text="%base.filePath"
                                     resizable="true"/>
                </columns>
                <VBox.margin>
                    <Insets left="30" top="10"/>
                </VBox.margin>
            </DataExportTableTableView>
            <FlexHBox flexWidth="100%" realHeight="50">
                <FlexButton text="%base.selectAll" onAction="#selectAllTable" realHeight="30">
                    <HBox.margin>
                        <Insets left="30" top="10"/>
                    </HBox.margin>
                </FlexButton>
                <FlexButton text="%base.unselectAll" onAction="#unselectAllTable" realHeight="30">
                    <HBox.margin>
                        <Insets left="15" top="10"/>
                    </HBox.margin>
                </FlexButton>
            </FlexHBox>
        </FlexVBox>
        <FlexHBox flexWidth="100%" realHeight="50">
            <PrevStepButton onAction="#showStep1" realHeight="30" iconSizePercent="0.75">
                <HBox.margin>
                    <Insets left="30" top="10"/>
                </HBox.margin>
            </PrevStepButton>
            <NextStepButton onAction="#showStep3" realHeight="30" iconSizePercent="0.75">
                <HBox.margin>
                    <Insets left="15" top="10"/>
                </HBox.margin>
            </NextStepButton>
            <CancelButton iconSizePercent="0.6" realHeight="30">
                <HBox.margin>
                    <Insets left="15" top="10"/>
                </HBox.margin>
            </CancelButton>
        </FlexHBox>
    </FlexVBox>
    <FlexVBox fx:id="step3" flexHeight="100%" flexWidth="100%" managed="false" visible="false">
        <FlexLabel text="%db.export.tip6" realHeight="30" fontSize="16">
            <VBox.margin>
                <Insets left="30" top="10"/>
            </VBox.margin>
        </FlexLabel>
        <FlexVBox flexHeight="100% - 100" flexWidth="100%">
            <DataExportTableComboBox realHeight="30" flexWidth="100% - 140" fx:id="tableCombobox">
                <VBox.margin>
                    <Insets left="30" top="10"/>
                </VBox.margin>
            </DataExportTableComboBox>
            <DataExportColumnListView flexHeight="100% - 100" flexWidth="100% - 140" fx:id="tableColumns">
                <VBox.margin>
                    <Insets left="30" top="10"/>
                </VBox.margin>
            </DataExportColumnListView>
            <FlexHBox flexWidth="100%" realHeight="50">
                <FlexButton text="%base.selectAll" onAction="#selectAllFiled" realHeight="30">
                    <HBox.margin>
                        <Insets left="30" top="10"/>
                    </HBox.margin>
                </FlexButton>
                <FlexButton text="%base.unselectAll" onAction="#unselectAllField" realHeight="30">
                    <HBox.margin>
                        <Insets left="15" top="10"/>
                    </HBox.margin>
                </FlexButton>
            </FlexHBox>
        </FlexVBox>
        <FlexHBox flexWidth="100%" realHeight="50">
            <PrevStepButton onAction="#showStep2" realHeight="30" iconSizePercent="0.75">
                <HBox.margin>
                    <Insets left="30" top="10"/>
                </HBox.margin>
            </PrevStepButton>
            <NextStepButton onAction="#showStep4" realHeight="30" iconSizePercent="0.75">
                <HBox.margin>
                    <Insets left="15" top="10"/>
                </HBox.margin>
            </NextStepButton>
            <CancelButton iconSizePercent="0.6" realHeight="30">
                <HBox.margin>
                    <Insets left="15" top="10"/>
                </HBox.margin>
            </CancelButton>
        </FlexHBox>
    </FlexVBox>
    <FlexVBox fx:id="step4" flexHeight="100%" flexWidth="100%" managed="false" visible="false">
        <FlexLabel text="%db.export.tip7" realHeight="30" fontSize="16">
            <VBox.margin>
                <Insets left="30" top="10"/>
            </VBox.margin>
        </FlexLabel>
        <FlexVBox flexHeight="100% - 100" flexWidth="100%">
            <FlexCheckBox text="%db.export.tip10" fx:id="includeFields" selected="true" visible="false" managed="false"
                          groupId="includeFields">
                <VBox.margin>
                    <Insets left="30" top="15"/>
                </VBox.margin>
            </FlexCheckBox>
            <FXCheckBox text="%db.export.tip11" fx:id="earlyVersion" visible="false" managed="false" groupId="earlyVersion">
                <VBox.margin>
                    <Insets left="30" top="10"/>
                </VBox.margin>
            </FXCheckBox>
            <FlexCheckBox text="%db.export.tip1" selected="true">
                <VBox.margin>
                    <Insets left="30" top="15"/>
                </VBox.margin>
            </FlexCheckBox>
            <FlexLabel text="%base.fileFormat" realHeight="30" fontWeight="BOLD" groupId="fieldToAttr" managed="false"
                       visible="false">
                <VBox.margin>
                    <Insets left="30" top="15"/>
                </VBox.margin>
            </FlexLabel>
            <FXCheckBox text="%db.export.tip11" fx:id="fieldToAttr" visible="false" managed="false" groupId="fieldToAttr">
                <VBox.margin>
                    <Insets left="30" top="10"/>
                </VBox.margin>
            </FXCheckBox>
            <FlexLabel text="%base.dateFormat" realHeight="30" fontWeight="BOLD" groupId="dateFormat" managed="false"
                       visible="false">
                <VBox.margin>
                    <Insets left="30" top="15"/>
                </VBox.margin>
            </FlexLabel>
            <FlexHBox realHeight="30" flexWidth="100%" groupId="dateFormat" managed="false" visible="false">
                <DataDateTextFiled realWidth="250" realHeight="30" promptText="%db.export.tip9"
                                   text="yyyy-MM-dd HH:mm:ss" fx:id="dateFormat">
                    <HBox.margin>
                        <Insets left="30" top="5"/>
                    </HBox.margin>
                </DataDateTextFiled>
                <FlexLabel fx:id="datePreview">
                    <HBox.margin>
                        <Insets left="10" top="10"/>
                    </HBox.margin>
                </FlexLabel>
            </FlexHBox>
            <FlexLabel text="%base.recordSeparator" realHeight="30" fontWeight="BOLD" groupId="recordSeparator"
                       managed="false" visible="false">
                <VBox.margin>
                    <Insets left="30" top="15"/>
                </VBox.margin>
            </FlexLabel>
            <DataRecordSeparatorComboBox realWidth="250" realHeight="30" fx:id="recordSeparator"
                                         groupId="recordSeparator" managed="false" visible="false">
                <VBox.margin>
                    <Insets left="30" top="5"/>
                </VBox.margin>
            </DataRecordSeparatorComboBox>
            <FlexLabel text="%base.fieldSeparator" realHeight="30" fontWeight="BOLD" groupId="fieldSeparator"
                       managed="false" visible="false">
                <VBox.margin>
                    <Insets left="30" top="15"/>
                </VBox.margin>
            </FlexLabel>
            <DataFieldSeparatorComboBox initIndex="0" realWidth="250" realHeight="30" fx:id="fieldSeparator"
                                        groupId="fieldSeparator" managed="false" visible="false">
                <VBox.margin>
                    <Insets left="30" top="5"/>
                </VBox.margin>
            </DataFieldSeparatorComboBox>
            <FlexLabel text="%base.txtIdentifier" realHeight="30" fontWeight="BOLD" groupId="txtIdentifier"
                       managed="false" visible="false">
                <VBox.margin>
                    <Insets left="30" top="15"/>
                </VBox.margin>
            </FlexLabel>
            <DataTxtIdentifierComboBox initIndex="0" realWidth="250" realHeight="30" fx:id="txtIdentifier"
                                       groupId="txtIdentifier" managed="false" visible="false">
                <VBox.margin>
                    <Insets left="30" top="5"/>
                </VBox.margin>
            </DataTxtIdentifierComboBox>
        </FlexVBox>
        <FlexHBox flexWidth="100%" realHeight="50">
            <PrevStepButton onAction="#showStep3" realHeight="30" iconSizePercent="0.75">
                <HBox.margin>
                    <Insets left="30" top="10"/>
                </HBox.margin>
            </PrevStepButton>
            <NextStepButton onAction="#showStep5" realHeight="30" iconSizePercent="0.75">
                <HBox.margin>
                    <Insets left="15" top="10"/>
                </HBox.margin>
            </NextStepButton>
            <CancelButton iconSizePercent="0.6" realHeight="30">
                <HBox.margin>
                    <Insets left="15" top="10"/>
                </HBox.margin>
            </CancelButton>
        </FlexHBox>
    </FlexVBox>
    <FlexVBox fx:id="step5" flexHeight="100%" flexWidth="100%" managed="false" visible="false">
        <FlexLabel text="%db.export.tip8" realHeight="30" fontSize="16">
            <VBox.margin>
                <Insets left="30" top="10"/>
            </VBox.margin>
        </FlexLabel>
        <FlexVBox flexWidth="100%" flexHeight="100% - 100">
            <MsgTextArea lineLimit="300" fx:id="exportMsg" flexWidth="100% - 80" flexHeight="100% - 50">
                <VBox.margin>
                    <Insets left="30" top="10"/>
                </VBox.margin>
            </MsgTextArea>
            <FXLabel fx:id="exportStatus" realHeight="30">
                <VBox.margin>
                    <Insets left="30"/>
                </VBox.margin>
            </FXLabel>
        </FlexVBox>
        <FlexHBox flexWidth="100%" realHeight="50">
            <PrevStepButton onAction="#showStep4" groupId="exec" realHeight="30" iconSizePercent="0.75">
                <HBox.margin>
                    <Insets left="30" top="10"/>
                </HBox.margin>
            </PrevStepButton>
            <ExportButton tipText="%base.start" groupId="exec" onAction="#doExport" realHeight="30">
                <HBox.margin>
                    <Insets left="15" top="10"/>
                </HBox.margin>
            </ExportButton>
            <StopButton disable="true" fx:id="stopExportBtn" onAction="#stopExport" realHeight="30"
                        iconSizePercent="0.9">
                <HBox.margin>
                    <Insets left="15" top="10"/>
                </HBox.margin>
            </StopButton>
            <CancelButton iconSizePercent="0.6" realHeight="30">
                <HBox.margin>
                    <Insets left="15" top="10"/>
                </HBox.margin>
            </CancelButton>
        </FlexHBox>
    </FlexVBox>
</FlexVBox>
