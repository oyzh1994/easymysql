<?xml version="1.0" encoding="UTF-8"?>
<?import cn.oyzh.easydb.fx.DBTypeComboBox?>
<?import cn.oyzh.easydb.fx.info.ServiceTypeCombobox?>
<?import cn.oyzh.fx.plus.controls.area.FlexTextArea?>
<?import cn.oyzh.fx.plus.controls.box.FlexHBox?>
<?import cn.oyzh.fx.plus.controls.box.FlexVBox?>
<?import cn.oyzh.fx.plus.controls.button.CancelButton?>
<?import cn.oyzh.fx.plus.controls.button.FlexCheckBox?>
<?import cn.oyzh.fx.plus.controls.button.SubmitButton?>
<?import cn.oyzh.fx.plus.controls.button.TestButton?>
<?import cn.oyzh.fx.plus.controls.tab.FlexTabPane?>
<?import cn.oyzh.fx.plus.controls.tab.FXTab?>
<?import cn.oyzh.fx.plus.controls.text.AccentLabel?>
<?import cn.oyzh.fx.plus.controls.text.FXLabel?>
<?import cn.oyzh.fx.plus.controls.textfield.ClearableTextField?>
<?import cn.oyzh.fx.plus.controls.textfield.NumberTextField?>
<?import cn.oyzh.fx.plus.controls.textfield.PortTextField?>
<?import cn.oyzh.fx.plus.controls.toggle.SwitchToggleSwitch?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<FlexVBox styleClass="root" xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="cn.oyzh.easydb.controller.info.DBInfoAddController" realWidth="750" realHeight="450">
    <FlexTabPane flexWidth="100%" flexHeight="100% - 60" fx:id="tabPane">
        <FXTab text="%base.base">
            <FlexVBox flexWidth="100%" flexHeight="100%">
                <FlexHBox flexWidth="100%" realHeight="50">
                    <AccentLabel realHeight="30" realWidth="100" text="%base.name">
                        <HBox.margin>
                            <Insets left="20" top="10"/>
                        </HBox.margin>
                    </AccentLabel>
                    <ClearableTextField tipText="%base.nameTip" maxLen="30" require="true" fx:id="name"
                                        realHeight="30" flexWidth="100% - 140">
                        <HBox.margin>
                            <Insets left="10" top="10"/>
                        </HBox.margin>
                    </ClearableTextField>
                </FlexHBox>
                <FlexHBox flexWidth="100%" realHeight="50">
                    <AccentLabel realHeight="30" realWidth="100" text="%base.type">
                        <HBox.margin>
                            <Insets left="20" top="10"/>
                        </HBox.margin>
                    </AccentLabel>
                    <DBTypeComboBox require="true" fx:id="type"
                                    realHeight="30" flexWidth="100% - 140" initIndex="0">
                        <HBox.margin>
                            <Insets left="10" top="10"/>
                        </HBox.margin>
                    </DBTypeComboBox>
                </FlexHBox>
                <FlexHBox flexWidth="100%" realHeight="50">
                    <AccentLabel realHeight="30" realWidth="100" text="%base.host">
                        <HBox.margin>
                            <Insets left="20" top="10"/>
                        </HBox.margin>
                    </AccentLabel>
                    <ClearableTextField fx:id="hostIp" tipText="%base.hostTip" require="true"
                                        realHeight="30"
                                        flexWidth="100% - 305" maxLen="1024">
                        <HBox.margin>
                            <Insets left="10" top="10"/>
                        </HBox.margin>
                    </ClearableTextField>
                    <PortTextField flexWidth="100" fx:id="hostPort" tipText="%base.port" realHeight="30"
                                   value="3306">
                        <HBox.margin>
                            <Insets left="5" top="10"/>
                        </HBox.margin>
                    </PortTextField>
                </FlexHBox>
                <FlexHBox flexWidth="100%" realHeight="50">
                    <AccentLabel realHeight="30" realWidth="100" text="%base.authInfo">
                        <HBox.margin>
                            <Insets left="20" top="10"/>
                        </HBox.margin>
                    </AccentLabel>
                    <ClearableTextField fx:id="user" tipText="%base.userNameTip"
                                        realHeight="30" flexWidth="50% - 70">
                        <HBox.margin>
                            <Insets left="10" top="10"/>
                        </HBox.margin>
                    </ClearableTextField>
                    <ClearableTextField fx:id="password" tipText="%base.passwordTip"
                                        require="true"
                                        realHeight="30" flexWidth="50% - 75">
                        <HBox.margin>
                            <Insets left="5" top="10"/>
                        </HBox.margin>
                    </ClearableTextField>
                </FlexHBox>
                <FlexHBox flexWidth="100%" realHeight="50" fx:id="serviceBox" managed="false" visible="false">
                    <AccentLabel realHeight="30" realWidth="100" text="%base.serviceName">
                        <HBox.margin>
                            <Insets left="20" top="10"/>
                        </HBox.margin>
                    </AccentLabel>
                    <ClearableTextField fx:id="serviceName" tipText="%base.serviceName"
                                        realHeight="30"
                                        flexWidth="100% -265" maxLen="1024">
                        <HBox.margin>
                            <Insets left="10" top="10"/>
                        </HBox.margin>
                    </ClearableTextField>
                    <ServiceTypeCombobox fx:id="serviceType" realWidth="120" initIndex="0" realHeight="30">
                        <HBox.margin>
                            <Insets left="5" top="10"/>
                        </HBox.margin>
                    </ServiceTypeCombobox>
                </FlexHBox>
            </FlexVBox>
        </FXTab>
        <FXTab text="%base.advanced">
            <FlexVBox flexWidth="100%" flexHeight="100%">
                <FlexHBox flexWidth="100%" realHeight="50">
                    <AccentLabel realHeight="30" realWidth="100" text="%base.options">
                        <HBox.margin>
                            <Insets left="20" top="10"/>
                        </HBox.margin>
                    </AccentLabel>
                    <FlexCheckBox text="%base.readonlyMode" tipText="%base.readonlyModeTip" fx:id="readonly">
                        <HBox.margin>
                            <Insets left="10" top="16"/>
                        </HBox.margin>
                    </FlexCheckBox>
                </FlexHBox>
                <FlexHBox flexWidth="100%" realHeight="50">
                    <AccentLabel realHeight="30" realWidth="100" text="%base.connectTimeout">
                        <HBox.margin>
                            <Insets left="20" top="10"/>
                        </HBox.margin>
                    </AccentLabel>
                    <NumberTextField realHeight="30" flexWidth="100% - 220" min="3" max="30" fx:id="connectTimeOut"
                                     tipText="%db.info.connectTimoutTip" value="5" require="true">
                        <HBox.margin>
                            <Insets left="10" top="10"/>
                        </HBox.margin>
                    </NumberTextField>
                    <FXLabel text="%base.second">
                        <HBox.margin>
                            <Insets left="5" top="18"/>
                        </HBox.margin>
                    </FXLabel>
                </FlexHBox>
                <FlexHBox flexWidth="100%" realHeight="100">
                    <AccentLabel realHeight="30" realWidth="100" text="%base.remark">
                        <HBox.margin>
                            <Insets left="20" top="10"/>
                        </HBox.margin>
                    </AccentLabel>
                    <FlexTextArea fx:id="remark" tipText="%base.remarkTip" maxLen="100"
                                  realHeight="80" flexWidth="100% - 140">
                        <HBox.margin>
                            <Insets left="10" top="10"/>
                        </HBox.margin>
                    </FlexTextArea>
                </FlexHBox>
            </FlexVBox>
        </FXTab>
        <FXTab text="%base.ssh">
            <FlexVBox flexWidth="100%" flexHeight="100%">
                <FlexHBox flexWidth="100%" realHeight="50">
                    <AccentLabel realHeight="30" realWidth="100" text="%base.enableSSHChannel">
                        <HBox.margin>
                            <Insets left="20" top="10"/>
                        </HBox.margin>
                    </AccentLabel>
                    <SwitchToggleSwitch fx:id="sshForward">
                        <HBox.margin>
                            <Insets left="10" top="15"/>
                        </HBox.margin>
                    </SwitchToggleSwitch>
                </FlexHBox>
                <FlexHBox flexWidth="100%" realHeight="50" fx:id="sshHostBox" disable="true">
                    <AccentLabel realHeight="30" realWidth="100" text="%base.host">
                        <HBox.margin>
                            <Insets left="20" top="10"/>
                        </HBox.margin>
                    </AccentLabel>
                    <ClearableTextField fx:id="sshHost" tipText="%base.hostTip" require="true" realHeight="30"
                                        flexWidth="100% - 285" maxLen="1024">
                        <HBox.margin>
                            <Insets left="10" top="10"/>
                        </HBox.margin>
                    </ClearableTextField>
                    <PortTextField realWidth="100" fx:id="sshPort" realHeight="30" value="22">
                        <HBox.margin>
                            <Insets left="5" top="10"/>
                        </HBox.margin>
                    </PortTextField>
                </FlexHBox>
                <FlexHBox flexWidth="100%" realHeight="50" fx:id="sshTimeoutBox" disable="true">
                    <AccentLabel realHeight="30" realWidth="100" text="%base.connectTimeout">
                        <HBox.margin>
                            <Insets left="20" top="10"/>
                        </HBox.margin>
                    </AccentLabel>
                    <NumberTextField flexWidth="100% - 180" fx:id="sshTimeout" tipText="%base.sshTimeoutTip"
                                     realHeight="30" value="3000">
                        <HBox.margin>
                            <Insets left="10" top="10"/>
                        </HBox.margin>
                    </NumberTextField>
                </FlexHBox>
                <FlexHBox flexWidth="100%" realHeight="50" fx:id="sshAuthBox" disable="true">
                    <AccentLabel realHeight="30" realWidth="100" text="%base.sshInfo">
                        <HBox.margin>
                            <Insets left="20" top="10"/>
                        </HBox.margin>
                    </AccentLabel>
                    <ClearableTextField fx:id="sshUser" tipText="%base.sshUserTip" require="true" realHeight="30"
                                        flexWidth="50% - 93" text="root">
                        <HBox.margin>
                            <Insets left="10" top="10"/>
                        </HBox.margin>
                    </ClearableTextField>
                    <ClearableTextField fx:id="sshPassword" tipText="%base.sshPwdTip" require="true" realHeight="30"
                                        flexWidth="50% - 92">
                        <HBox.margin>
                            <Insets left="5" top="10"/>
                        </HBox.margin>
                    </ClearableTextField>
                </FlexHBox>
            </FlexVBox>
        </FXTab>
    </FlexTabPane>
    <FlexHBox flexWidth="100%" realHeight="50">
        <TestButton onAction="#testConnect" iconSizePercent="0.8">
            <HBox.margin>
                <Insets left="130" top="10"/>
            </HBox.margin>
        </TestButton>
        <SubmitButton onAction="#add" text="%base.add">
            <HBox.margin>
                <Insets left="15" top="10"/>
            </HBox.margin>
        </SubmitButton>
        <CancelButton>
            <HBox.margin>
                <Insets left="15" top="10"/>
            </HBox.margin>
        </CancelButton>
    </FlexHBox>
</FlexVBox>
