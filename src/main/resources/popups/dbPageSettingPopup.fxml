<?xml version="1.0" encoding="UTF-8"?>
<?import cn.oyzh.fx.plus.controls.box.FlexHBox?>
<?import cn.oyzh.fx.plus.controls.box.FlexVBox?>
<?import cn.oyzh.fx.plus.controls.svg.ApplySVGGlyph?>
<?import cn.oyzh.fx.plus.controls.svg.CancelSVGGlyph?>
<?import cn.oyzh.fx.plus.controls.text.AccentLabel?>
<?import cn.oyzh.fx.plus.controls.textfield.NumberTextField?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<FlexVBox styleClass="root" xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="cn.oyzh.easymysql.popups.DBPageSettingPopupController" realWidth="280"
          realHeight="80">
    <FlexHBox flexWidth="100%" realHeight="30">
        <AccentLabel realHeight="25" realWidth="70" text="%base.pageLimit">
            <HBox.margin>
                <Insets left="10" top="5"/>
            </HBox.margin>
        </AccentLabel>
        <NumberTextField fx:id="limit" minVal="1" step="100" realHeight="25" flexWidth="100% - 120" styleClass="popover-item">
            <HBox.margin>
                <Insets left="5" top="5"/>
            </HBox.margin>
        </NumberTextField>
    </FlexHBox>
    <FlexHBox flexWidth="100%" realHeight="25">
        <ApplySVGGlyph onMousePrimaryClicked="#apply" sizeStr="15,11">
            <HBox.margin>
                <Insets left="85" top="5"/>
            </HBox.margin>
        </ApplySVGGlyph>
        <CancelSVGGlyph onMousePrimaryClicked="#close" sizeStr="11">
            <HBox.margin>
                <Insets left="30" top="5"/>
            </HBox.margin>
        </CancelSVGGlyph>
    </FlexHBox>
</FlexVBox>
